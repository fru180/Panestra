{
  "name": "panestra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,daemon 'pnpm dev:web' 'pnpm dev:daemon'",
    "dev:web": "pnpm --filter @panestra/web dev",
    "dev:daemon": "cargo run -p panestra-daemon -- --listen 127.0.0.1:8371 --dev-web-origin http://127.0.0.1:8372",
    "build": "pnpm --filter @panestra/web build && mise exec -- cargo build -p panestra-daemon --release",
    "check": "pnpm format:check && pnpm lint && pnpm --filter @panestra/web typecheck",
    "format": "prettier --write . && mise exec -- cargo fmt --all",
    "format:check": "prettier --check . && mise exec -- cargo fmt --all --check",
    "lint": "pnpm --filter @panestra/web lint && mise exec -- cargo clippy --workspace --all-targets -- -D warnings",
    "lint:fix": "pnpm --filter @panestra/web lint:fix",
    "prepare": "husky",
    "test": "pnpm test:web && pnpm test:rust",
    "test:web": "pnpm --filter @panestra/web test",
    "test:rust": "mise exec -- cargo test --workspace --all-targets"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2"
  }
}
